# JuvorAI 环境变量配置示例
# 复制为 .env 后按需修改

# 数据库（Docker Compose 已内置，本地开发时可覆盖）
# SQL_DSN=postgresql://root:123456@localhost:5432/juvorai

# Redis
# REDIS_CONN_STRING=redis://:123456@localhost:6379

# 会话密钥（生产环境必须修改！）
# SESSION_SECRET=your_random_secret_string_here

# 时区
TZ=Asia/Shanghai

# 节点名称（多节点部署时使用）
NODE_NAME=juvorai-node-1

# 流式响应超时（秒）
# STREAMING_TIMEOUT=300

# 错误日志
ERROR_LOG_ENABLED=true
