# JuvorAI 本地运行配置（无需 Docker）
# 复制为 .env 后按需修改: cp .env.native.example .env

# 端口
PORT=3000

# SQLite 数据库路径（无需安装 PostgreSQL/MySQL）
SQLITE_PATH=./data/juvorai.db

# 不设置 SQL_DSN 和 REDIS_CONN_STRING 即可使用 SQLite + 内存缓存
# 启用内存缓存（无 Redis 时推荐开启）
MEMORY_CACHE_ENABLED=true

# 时区
TZ=Asia/Shanghai

# 节点名称
NODE_NAME=juvorai-local

# 错误日志
ERROR_LOG_ENABLED=true

# 批量更新
BATCH_UPDATE_ENABLED=true

# 流式响应超时（秒）
# STREAMING_TIMEOUT=300

# 生产环境请设置随机字符串
# SESSION_SECRET=your_random_secret_here
